#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STATE="$ROOT/.vm"

BASE="$STATE/ubuntu.img"
DISK="$STATE/disk.qcow2"
SEED="$STATE/seed.img"
PIDFILE="$STATE/qemu.pid"

IMAGE_URL="https://cloud-images.ubuntu.com/releases/noble/release/ubuntu-24.04-server-cloudimg-amd64.img"

SSH_HOST="127.0.0.1"
SSH_PORT="${VPN_NODE_VM_PORT:-2222}"
SSH_USER="dev"
SSH_KEY="${VPN_NODE_VM_SSH_KEY:-$HOME/.ssh/id_ed25519}"

ssh_opts=(
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
    -o LogLevel=ERROR
    -i "$SSH_KEY"
    -p "$SSH_PORT"
)

is_running() {
    test -f "$PIDFILE" || return 1

    local pid
    pid="$(cat "$PIDFILE")"

    if kill -0 "$pid" 2>/dev/null; then
        return 0
    fi

    rm -f "$PIDFILE"
    return 1
}

require_init() {
    if [ ! -f "$DISK" ] || [ ! -f "$SEED" ]; then
        echo "vm is not initialized; run: $0 init" >&2
        exit 1
    fi
}

wait_for_ssh() {
    printf 'waiting for ssh'

    for _ in $(seq 1 60); do
        if ssh "${ssh_opts[@]}" \
            "$SSH_USER@$SSH_HOST" true 2>/dev/null; then
            echo
            return 0
        fi

        printf '.'
        sleep 1
    done

    echo
    echo "ssh did not become ready" >&2
    return 1
}

case "${1:-}" in
    init)
        if is_running; then
            echo "vm is running; stop it first" >&2
            exit 1
        fi

        mkdir -p "$STATE"

        if [ ! -f "$BASE" ]; then
            echo "downloading Ubuntu 24.04 cloud image..."
            curl -fL "$IMAGE_URL" -o "$BASE"
        fi

        if [ -f "$DISK" ] || [ -f "$SEED" ]; then
            echo "vm is already initialized" >&2
            exit 1
        fi

        echo "creating VM disk..."
        qemu-img create \
            -f qcow2 \
            -F qcow2 \
            -b "$BASE" \
            "$DISK" \
            16G

        if [ ! -f "$SSH_KEY.pub" ]; then
            echo "ssh public key not found: $SSH_KEY.pub" >&2
            exit 1
        fi

        sed "s|SSH_KEY|$(cat "$SSH_KEY.pub")|" \
            "$ROOT/dev/cloud-init.yaml" \
            > "$STATE/user-data"

        printf '%s\n' \
            'instance-id: vpn-node-dev' \
            'local-hostname: vpn-node' \
            > "$STATE/meta-data"

        cloud-localds \
            "$SEED" \
            "$STATE/user-data" \
            "$STATE/meta-data"

        echo "vm initialized"
        ;;

    up)
        require_init

        if is_running; then
            echo "vm is already running"
            exit 0
        fi

        if ss -ltn | grep -q ":$SSH_PORT "; then
            echo "host port $SSH_PORT is already in use" >&2
            exit 1
        fi

        echo "starting vm..."

        qemu-system-x86_64 \
            -enable-kvm \
            -machine accel=kvm \
            -cpu host \
            -m 2048 \
            -smp 2 \
            -display none \
            -daemonize \
            -pidfile "$PIDFILE" \
            -drive "file=$DISK,if=virtio" \
            -drive "file=$SEED,format=raw,if=virtio" \
	    -nic "user,model=virtio-net-pci,hostfwd=tcp:$SSH_HOST:$SSH_PORT-:22,hostfwd=udp:$SSH_HOST:51820-:51820"
        wait_for_ssh

        echo "vm ready: ssh $SSH_USER@$SSH_HOST -p $SSH_PORT"
        ;;

    down)
        if ! is_running; then
            echo "vm is not running"
            exit 0
        fi

        pid="$(cat "$PIDFILE")"

        echo "stopping vm..."
        kill "$pid"

        for _ in $(seq 1 30); do
            if ! kill -0 "$pid" 2>/dev/null; then
                rm -f "$PIDFILE"
                echo "vm stopped"
                exit 0
            fi

            sleep 0.2
        done

        echo "vm did not stop gracefully; killing it" >&2
        kill -9 "$pid" 2>/dev/null || true
        rm -f "$PIDFILE"
        ;;

    reset)
        "$0" down

        rm -f \
            "$DISK" \
            "$SEED" \
            "$STATE/user-data" \
            "$STATE/meta-data"

        "$0" init
        ;;

    ssh)
        require_init

        if ! is_running; then
            echo "vm is not running" >&2
            exit 1
        fi

        exec ssh "${ssh_opts[@]}" "$SSH_USER@$SSH_HOST"
        ;;

    sync)
        require_init

        if ! is_running; then
            echo "vm is not running" >&2
            exit 1
        fi

        rsync -az --delete \
	    --exclude '.git/' \
	    --exclude '.vm/' \
	    --exclude '.venv/' \
	    --exclude '__pycache__/' \
	    --exclude '*.pyc' \
            -e "ssh -i $SSH_KEY -p $SSH_PORT -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR" \
            "$ROOT/" \
            "$SSH_USER@$SSH_HOST:~/vpn-node/"

	ssh "${ssh_opts[@]}" "$SSH_USER@$SSH_HOST" \
	    "sudo uv sync --frozen --no-editable --reinstall-package vpn-node --project /home/$SSH_USER/vpn-node"
	ssh "${ssh_opts[@]}" "$SSH_USER@$SSH_HOST" \
	    "sudo uv sync --frozen --no-editable --reinstall-package vpn-node --project /home/$SSH_USER/vpn-node && \
	     sudo install -m 0644 /home/$SSH_USER/vpn-node/src/vpn_node/static/status.html /usr/share/vpn-node/status.html && \
	     sudo install -m 0644 /home/$SSH_USER/vpn-node/src/vpn_node/static/style.css /usr/share/vpn-node/assets/style.css && \
	     sudo install -m 0644 /home/$SSH_USER/vpn-node/src/vpn_node/static/status.js /usr/share/vpn-node/assets/status.js"
        ;;


    status)
        if is_running; then
            echo "running pid=$(cat "$PIDFILE") ssh=$SSH_HOST:$SSH_PORT"
        else
            echo "stopped"
        fi
        ;;
    
    tunnel)
	    require_init

	    if ! is_running; then
		echo "vm is not running" >&2
		exit 1
	    fi

	    exec ssh \
		"${ssh_opts[@]}" \
		-N \
		-L 8080:127.0.0.1:8080 \
		"$SSH_USER@$SSH_HOST"
	    ;;

    *)
        echo "usage: $0 {init|up|down|reset|ssh|sync|tunnel|status}" >&2
        exit 2
        ;;
esac
